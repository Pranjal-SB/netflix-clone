<section class="row"<% if (typeof anchor !== "undefined" && anchor) { %> id="<%= anchor %>"<% } %>>
  <div class="row-head">
    <h2 class="row-title"><%= rowTitle %></h2>
    <% if (typeof rowSubtitle === "string" && rowSubtitle) { %><span class="row-subtitle"><%= rowSubtitle %></span><% } %>
  </div>
  <div class="row-cards-wrap">
    <div class="row-cards">
      <% items.forEach(function (item, i) { %>
        <%- include("card", { item, inList, csrfToken, back, numbered: !!numbered, rank: i + 1 }) %>
      <% }); %>
    </div>
  </div>
</section>
