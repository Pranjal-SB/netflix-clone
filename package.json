{
  "name": "netflix-clone",
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1",
    "db:setup": "node --env-file-if-exists=.env scripts/db-setup.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "connect-pg-simple": "^10.0.0",
    "csrf-sync": "^4.2.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "supertest": "^7.1.1"
  }
}
